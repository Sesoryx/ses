/* ses — generated by ThemeManager from token JSON. Do not edit the output. */

QWidget {
  background: @bg;
  color: @text;
  font-size: @fontBase;
}
QMainWindow, QDialog { background: @bg; }
QMenuBar { background: @panel; color: @text; border-bottom: 1px solid @border; }
QMenuBar::item { background: transparent; color: @text; padding: 5px 8px; }
QMenuBar::item:selected { background: @bgAlt; }
QMenuBar::item:pressed { background: @panelAlt; }
QWidget:focus { outline: none; }

QToolTip {
  background: @panel; color: @text;
  border: 1px solid @border; padding: 4px 8px;
}

QFrame#Panel { background: @panel; border: 1px solid @border; border-radius: @radius; }
QFrame#TransportBar { background: @panel; border: none; border-bottom: 1px solid @border; }
QFrame#Card { background: @panel; border: 1px solid @border; border-radius: @radius; }
QFrame#Card[status="pending"] { border: 1px dashed @border; }
QFrame#Toast { background: @panel; border: 1px solid @border; border-radius: @radius; }
QFrame#CoachMark { background: @bgAlt; border: 1px solid @border; border-radius: @radius; }
QFrame#EmptyState { background: transparent; border: 2px dashed @border; border-radius: @radius; }
QFrame#TrackRow { background: @panel; border: none; border-bottom: 1px solid @border; }
QToolButton[variant="mini"] {
  padding: 1px 6px; font-size: 10px; font-weight: 700;
  border: 1px solid @border; border-radius: 4px;
  background: @bgAlt; color: @textSecondary;
}
QToolButton[variant="mini"][kind="mute"]:checked { background: @danger; border-color: @danger; color: @accentText; }
QToolButton[variant="mini"][kind="solo"]:checked { background: @warning; border-color: @warning; color: @accentText; }

QLabel { background: transparent; }
QLabel[role="secondary"] { color: @textSecondary; font-size: @fontSmall; }
QLabel[role="danger"] { color: @danger; }
QLabel[role="title"] { font-size: @fontTitle; font-weight: 600; }
QLabel#TimeDisplay {
  font-family: "monospace"; font-size: 15px; color: @text;
  background: @bgAlt; border: 1px solid @border; border-radius: @radiusSmall;
  padding: 4px 10px;
}
QLabel#Badge {
  background: @bgAlt; border: 1px solid @border; border-radius: 10px;
  padding: 2px 10px; color: @textSecondary; font-size: @fontSmall;
}
QLabel#Badge[status="ok"] { color: @ok; }
QLabel#Badge[status="warn"] { color: @warning; }
QLabel#Badge[status="danger"] { color: @danger; }

QPushButton {
  background: @bgAlt; color: @text;
  border: 1px solid @border; border-radius: @radiusSmall;
  padding: 6px 14px;
}
QPushButton:hover { border-color: @accent; }
QPushButton:pressed { background: @panelAlt; }
QPushButton:focus { border-color: @accent; }
QPushButton:disabled { color: @textSecondary; background: @bg; border-color: @border; }
QPushButton[variant="primary"] { background: @accent; color: @accentText; border: none; font-weight: 600; }
QPushButton[variant="primary"]:hover { background: @accentHover; }
QPushButton[variant="primary"]:disabled { background: @border; color: @textSecondary; }
QPushButton[variant="ghost"] { background: transparent; border: none; color: @textSecondary; }
QPushButton[variant="ghost"]:hover { color: @text; background: @bgAlt; }

QToolButton {
  background: transparent; border: 1px solid transparent;
  border-radius: @radiusSmall; padding: 5px; color: @text;
}
QToolButton:hover { background: @bgAlt; border-color: @border; }
QToolButton:checked { background: @bgAlt; border-color: @accent; color: @accent; }
QToolButton:focus { border-color: @accent; }
QToolButton:disabled { color: @textSecondary; }
QToolButton[variant="transport"] { padding: 7px; border-radius: 16px; }
QToolButton[variant="transport"]:checked { background: @accent; color: @accentText; border-color: @accent; }
QToolButton[variant="chip"] {
  padding: 2px 8px; font-size: @fontSmall; font-weight: 600;
  border: 1px solid @border; border-radius: 9px; background: @bgAlt; color: @textSecondary;
}
QToolButton[variant="mode"] {
  padding: 2px 4px; font-size: 9px; font-weight: 600;
  border: 1px solid @border; border-radius: 9px; background: @bgAlt; color: @textSecondary;
}
QToolButton[variant="chip"][route="A"] { color: @accent; border-color: @accent; }
QToolButton[variant="chip"][route="B"] { color: @warning; border-color: @warning; }
QToolButton[variant="chip"][route="both"] { color: @textSecondary; }

QSlider::groove:horizontal { height: 4px; background: @border; border-radius: 2px; }
QSlider::handle:horizontal {
  width: 14px; height: 14px; margin: -5px 0;
  border-radius: 7px; background: @accent;
}
QSlider::handle:horizontal:hover { background: @accentHover; }
QSlider::groove:vertical { width: 4px; background: @border; border-radius: 2px; }
QSlider::handle:vertical {
  height: 14px; width: 14px; margin: 0 -5px;
  border-radius: 7px; background: @accent;
}
QSlider::handle:vertical:hover { background: @accentHover; }

QTabWidget::pane { border: 1px solid @border; border-radius: @radius; background: @panel; top: -1px; }
QTabBar { background: transparent; }
QTabBar::tab {
  background: transparent; color: @textSecondary;
  padding: 8px 14px; border: none; border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: @text; border-bottom: 2px solid @accent; }
QTabBar::tab:hover { color: @text; }

QScrollBar:vertical { background: transparent; width: 10px; margin: 0; }
QScrollBar::handle:vertical { background: @border; border-radius: 5px; min-height: 30px; }
QScrollBar::handle:vertical:hover { background: @textSecondary; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; }
QScrollBar::handle:horizontal { background: @border; border-radius: 5px; min-width: 30px; }
QScrollBar::handle:horizontal:hover { background: @textSecondary; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }
QScrollBar::corner { background: transparent; }

QSplitter::handle { background: @border; }
QSplitter::handle:horizontal { width: 1px; }
QSplitter::handle:vertical { height: 1px; }

QStatusBar {
  background: @panel; border-top: 1px solid @border;
  color: @textSecondary; font-size: @fontSmall;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { color: @textSecondary; font-size: @fontSmall; }

QLineEdit, QPlainTextEdit, QTextEdit {
  background: @bgAlt; border: 1px solid @border; border-radius: @radiusSmall;
  padding: 5px 8px;
  selection-background-color: @accent; selection-color: @accentText;
}
QLineEdit:focus { border-color: @accent; }

QComboBox {
  background: @bgAlt; border: 1px solid @border; border-radius: @radiusSmall;
  padding: 5px 10px;
}
QComboBox:hover { border-color: @accent; }
QComboBox::drop-down { border: none; width: 20px; }
QComboBox QAbstractItemView {
  background: @panel; border: 1px solid @border;
  selection-background-color: @bgAlt; selection-color: @text;
}

QMenu { background: @panel; border: 1px solid @border; border-radius: @radius; padding: 4px; }
QMenu::item { padding: 6px 24px 6px 12px; border-radius: @radiusSmall; }
QMenu::item:selected { background: @bgAlt; color: @text; }
QMenu::item:disabled { color: @textSecondary; }
QMenu::separator { height: 1px; background: @border; margin: 4px 8px; }

QCheckBox { spacing: 8px; background: transparent; }
QCheckBox::indicator {
  width: 16px; height: 16px; border-radius: 4px;
  border: 1px solid @border; background: @bgAlt;
}
QCheckBox::indicator:checked { background: @accent; border-color: @accent; }

QProgressBar {
  background: @bgAlt; border: 1px solid @border; border-radius: @radiusSmall;
  height: 8px; text-align: center; color: transparent;
}
QProgressBar::chunk { background: @accent; border-radius: 3px; }

QUndoView { background: @panel; border: none; alternate-background-color: @panelAlt; }
QUndoView::item { padding: 6px 8px; border-radius: @radiusSmall; }
QUndoView::item:selected { background: @bgAlt; color: @text; }

QHeaderView::section {
  background: @panel; color: @textSecondary;
  border: none; border-bottom: 1px solid @border; padding: 6px;
}

QScrollArea { border: none; background: transparent; }
QAbstractScrollArea { border: none; background: @bg; }
QDialogButtonBox QPushButton { min-width: 80px; }